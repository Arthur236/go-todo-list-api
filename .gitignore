# Compiled binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Custom binary output directory (if you use `go build -o bin/`)
bin/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# Dependency directory 
# Uncomment the line below if you intentionally want to skip vendoring
# vendor/

# Local environment configuration secrets
.env
.env.*
!.env.example

# IDE and Editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
